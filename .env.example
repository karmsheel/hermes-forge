# Copy to .env (or .env.local) for local development. Never commit real secrets.

# SQLite database (relative paths are fine for dev)
DATABASE_URL="file:./dev.db"

# Required for signed session cookies (forge_session). Use a long random string.
AUTH_SECRET="replace-with-a-long-random-secret"

# --- GitHub OAuth (identity only; optional until you enable the button) ---
# 1. Create an OAuth App: https://github.com/settings/developers → OAuth Apps → New
# 2. Application name: Hermes Forge (dev)
# 3. Homepage URL:
#      Web/dev:     http://localhost:3000  (or http://127.0.0.1:3000)
#      Desktop:     http://127.0.0.1:3847   (Electron always uses 127.0.0.1)
# 4. Authorization callback URL — register EVERY host:port you open (cookies are host-scoped):
#      http://localhost:3000/api/auth/github/callback
#      http://127.0.0.1:3000/api/auth/github/callback
#      http://127.0.0.1:3847/api/auth/github/callback
#      http://localhost:3847/api/auth/github/callback
#    Prefer 127.0.0.1 for desktop so it matches Electron.
# 5. Copy Client ID + generate a Client secret into the vars below.
# Scopes requested by Forge: read:user, user:email (no repo scopes).
# Local → GitHub upgrades the same user when a session starts OAuth (or sole rich local).

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional absolute callback override (defaults to {request-origin}/api/auth/github/callback).
# If set, MUST match the host the browser/Electron uses (127.0.0.1 vs localhost).
# GITHUB_REDIRECT_URI="http://127.0.0.1:3847/api/auth/github/callback"
