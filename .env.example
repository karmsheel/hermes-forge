# Copy to .env (or .env.local) for local development. Never commit real secrets.

# SQLite database (relative paths are fine for dev)
DATABASE_URL="file:./dev.db"

# Required for signed session cookies (forge_session). Use a long random string.
AUTH_SECRET="replace-with-a-long-random-secret"

# --- GitHub OAuth (identity only; optional until you enable the button) ---
# 1. Create an OAuth App: https://github.com/settings/developers → OAuth Apps → New
# 2. Application name: Hermes Forge (dev)
# 3. Homepage URL:
#      Web/dev:     http://localhost:3000
#      Desktop dev: http://localhost:3847
# 4. Authorization callback URL (register each origin you use):
#      http://localhost:3000/api/auth/github/callback
#      http://localhost:3847/api/auth/github/callback
#    For a packaged desktop build, use the same host/port the app serves
#    (default FORGE_PORT=3847): http://localhost:3847/api/auth/github/callback
# 5. Copy Client ID + generate a Client secret into the vars below.
# Scopes requested by Forge: read:user, user:email (no repo scopes).

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional absolute callback override (defaults to {request-origin}/api/auth/github/callback)
# GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"
